# Copy to .env and fill in — .env is gitignored. These keys gate the two APIs
# and the dashboard. The committed default "mediflow-dev-key" is for local demo
# use only; production keys come from Key Vault (see infra/main.parameters.json).
MEDIFLOW_API_KEYS=mediflow-dev-key

# Override the SQL Server image for docker-compose (x64 hosts):
# SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
